{
  "manifest_version": 3,
  "name": "TasteRef",
  "version": "3.4.0",
  "description": "Copy the image or video under your cursor on any site and paste it into AI agents as a design reference.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://www.cosmos.so/*",
    "https://tasteref.henrikkvamme.no/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cosmos.so/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "TasteRef",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "commands": {
    "copy-reference": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Copy the image or video under the cursor"
    },
    "add-reference": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Add the image or video under the cursor to the clipboard"
    }
  }
}
